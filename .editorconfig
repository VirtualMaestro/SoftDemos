root = true

# C# conventions for this project.
#
# READ THIS FIRST: this file governs the IDE and nothing else. Unity never passes it to the
# compiler — `Library/Bee/*-inputdata.json` carries `"AnalyzerConfigPath": ""` and loads only Unity's
# own source generators — so nothing written here can fail a player build or a test run. Rider
# applies it live (it reads both `dotnet_*` and `resharper_*` keys), and
# `dotnet format style --severity info SoftDemos.sln` applies the fixable ones when someone
# runs it by hand. Naming rules are reported, never auto-renamed.
[*.cs]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

#### Braces ####
# Single-statement bodies carry no braces; the statement goes on its own indented line.
#
# This line does NOT enforce that — it only silences the opposite demand. Roslyn's brace analyzer
# treats `false` as PreferBracesPreference.None and returns before reporting anything:
#
#     var option = context.GetCSharpAnalyzerOptions().PreferBraces;
#     if (option.Value == PreferBracesPreference.None || ...) return;
#     — CSharpAddBracesDiagnosticAnalyzer.cs, dotnet/roslyn
#
# No diagnostic means no code fix, so `dotnet format` can never remove a redundant brace. Brace
# removal is a review rule with no tool behind it. Do not "fix" this by raising the severity.
csharp_prefer_braces = false:suggestion

#### var ####
# `var` everywhere the type is readable from the right-hand side.
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

#### Object creation ####
# `new()` when the declared type already says what is being constructed.
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion

#### Layout ####
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_keywords_in_control_flow_statements = true
dotnet_sort_system_directives_first = true

#### Unused usings ####
# Two keys, because neither one alone catches anything here.
#
# IDE0005 is Roslyn's redundant-using diagnostic. It is doubly out of reach: Unity's compiler never
# sees this file at all (see the header), and on the `dotnet format` path it stays silent unless the
# project emits a documentation file — which the Unity-generated .csproj does not, and editing that
# does not survive the next reimport. Declared anyway: it costs nothing and it becomes correct the
# day the csproj generator changes.
dotnet_diagnostic.IDE0005.severity = warning
#
# This is the key that actually catches them today — Rider reads `resharper_*` from .editorconfig,
# and `com.unity.ide.rider` is the installed IDE integration. Highlights on type; Optimize Usings on
# format removes them.
resharper_redundant_using_directive_highlighting = warning

#### Naming ####
# Private methods carry a leading underscore, the same marker private fields use, so a call
# site says at a glance whether it leaves the type.
dotnet_naming_rule.private_methods_underscore.symbols = private_method_symbols
dotnet_naming_rule.private_methods_underscore.style = underscore_pascal_case
dotnet_naming_rule.private_methods_underscore.severity = suggestion

dotnet_naming_symbols.private_method_symbols.applicable_kinds = method
dotnet_naming_symbols.private_method_symbols.applicable_accessibilities = private

dotnet_naming_style.underscore_pascal_case.capitalization = pascal_case
dotnet_naming_style.underscore_pascal_case.required_prefix = _

# The two const-like rules are declared before the instance-field rule because the first matching
# naming rule wins. A `private const` and a `private static readonly` array are constants in all
# but the keyword; `_timeoutSeconds` would read like mutable state.
dotnet_naming_rule.private_const_pascal.symbols = private_const_symbols
dotnet_naming_rule.private_const_pascal.style = plain_pascal_case
dotnet_naming_rule.private_const_pascal.severity = suggestion

dotnet_naming_symbols.private_const_symbols.applicable_kinds = field
dotnet_naming_symbols.private_const_symbols.applicable_accessibilities = private
dotnet_naming_symbols.private_const_symbols.required_modifiers = const

dotnet_naming_rule.private_static_readonly_pascal.symbols = private_static_readonly_symbols
dotnet_naming_rule.private_static_readonly_pascal.style = plain_pascal_case
dotnet_naming_rule.private_static_readonly_pascal.severity = suggestion

dotnet_naming_symbols.private_static_readonly_symbols.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_symbols.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly_symbols.required_modifiers = static, readonly

dotnet_naming_style.plain_pascal_case.capitalization = pascal_case

dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbols
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore.severity = suggestion

dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

# Events carry an `On` prefix so a subscription site cannot be mistaken for a property assignment.
# Only the *declaration* half of the rule is expressible here — a naming rule cannot reach the
# handler on the right of `+=`, so `_OnApply` stays a review rule (rules/base.md → Naming).
dotnet_naming_rule.events_on_prefix.symbols = event_symbols
dotnet_naming_rule.events_on_prefix.style = on_pascal_case
dotnet_naming_rule.events_on_prefix.severity = suggestion

dotnet_naming_symbols.event_symbols.applicable_kinds = event
dotnet_naming_symbols.event_symbols.applicable_accessibilities = *

dotnet_naming_style.on_pascal_case.capitalization = pascal_case
dotnet_naming_style.on_pascal_case.required_prefix = On

# A public field is a public member; whether its class is [Serializable] changes nothing.
dotnet_naming_rule.public_fields_pascal.symbols = public_field_symbols
dotnet_naming_rule.public_fields_pascal.style = plain_pascal_case
dotnet_naming_rule.public_fields_pascal.severity = suggestion

dotnet_naming_symbols.public_field_symbols.applicable_kinds = field
dotnet_naming_symbols.public_field_symbols.applicable_accessibilities = public

# MonoBehaviours live here, and three Roslyn rules are wrong about them. They stay on everywhere
# else — `Game.Simulation` has no Unity types, so there they are correct and still enforced.
[Assets/Client/Source/Runtime/{Adapters,Bootstrap}/**.cs]

# `[SerializeField] private` fields are camelCase with no underscore (rules/base.md). A naming
# symbol group can filter only by kind, accessibility and modifiers — never by attribute — so the
# exception cannot be written as a rule. Off here rather than underlining correct code; the cost is
# that ordinary private fields in these two folders lose the check.
dotnet_naming_rule.private_fields_underscore.severity = none

# Unity message methods (Awake, OnEnable, Update, OnDestroy, …) keep their exact names — Unity
# resolves them by name. Same limitation: a naming rule cannot exempt them.
dotnet_naming_rule.private_methods_underscore.severity = none

# IDE0044 wants `readonly` on serialized fields. Unity does not serialize readonly fields, so taking
# that advice silently empties the inspector reference.
dotnet_diagnostic.IDE0044.severity = none

# IDE0031 rewrites `if (button != null) button.X()` into `button?.X()`. Null propagation bypasses
# Unity's overloaded ==, so on a destroyed UnityEngine.Object that is the bug rules/base.md bans.
# This is the one rule here that is not merely noisy — it argues for the defect.
dotnet_diagnostic.IDE0031.severity = none

# Generated by Unity — never our source, never reformatted.
[{Library,Temp,obj,Logs,Build,Builds}/**]
generated_code = true

# Vendor code. `Assets/Client/` is the project; everything else under Assets/ is somebody else's.
# Marking it generated is what keeps `dotnet format` off it — otherwise a solution-wide run
# rewrites DOTween's sources and the next Asset Store reimport silently reverts the lot.
[Assets/{Plugins,ThirdParty}/**]
generated_code = true
